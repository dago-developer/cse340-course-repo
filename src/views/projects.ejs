<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <p>Here are some of our available service projects:</p>

    <ul>

        <% projects.forEach(project => { %>

            <li>
                <strong>
                    <%= new Date(project.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    }) %>:
                    <%= project.title %>
                </strong>

                (<em><%= project.organization_name %></em>)
            </li>

        <% }); %>

    </ul>

</main>

<%- include('partials/footer') %>