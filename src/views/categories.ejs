<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <p>Here are our service categories:</p>

    <ul>

        <% categories.forEach(category => { %>

            <li>
                <h2>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </h2>

                <p><%= category.description %></p>
            </li>

        <% }); %>

    </ul>

</main>

<%- include('partials/footer') %>